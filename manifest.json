{
  "name": "Tab Actions",
  "description": "Toggle tabs in popup windows, focus adjacent tabs, and move tabs within or between windows.",
  "version": "1.1.0",
  "manifest_version": 3,
  "minimum_chrome_version": "123",
  "permissions": ["contextMenus", "storage"],
  "action": { "default_title": "Toggle tab in popup" },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "a_toggleTabInPopup": {
      "suggested_key": { "default": "Ctrl+O", "mac": "Command+O" },
      "description": "Toggles tab in popup"
    },
    "aa_focusPrevTab": {
      "description": "Focus previous tab"
    },
    "ab_focusNextTab": {
      "description": "Focus next tab"
    },
    "b_moveTabToLeft": {
      "description": "Move tab to the left"
    },
    "c_moveTabToRight": {
      "description": "Move tab to the right"
    },
    "d_moveTabPrevWindow": {
      "description": "Move tab to previous window"
    },
    "e_moveTabNextWindow": {
      "description": "Move tab to next window"
    }
  }
}
